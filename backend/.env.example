# Portable Postgres connection. On Supabase Free this is the pooled or direct URI
# from Project Settings → Database. The backend talks to Postgres only, so the
# same app can run on any standard Node host.
DATABASE_URL=

# Present for Supabase projects. The Nest process does not send these to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to call this API.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

PORT=4000

# Free Quran text only (Uthmani), no key. This is not an Aqeedah source.
# https://alquran.cloud/api
QURAN_API_BASE_URL=https://api.alquran.cloud/v1

# Unused until the later Ask phase. Never expose it to the frontend.
LLM_API_KEY=
